# Only needed in production (Vercel). Local development needs no configuration.

# Postgres connection string. Added automatically when you connect a Neon database in Vercel > Storage.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Photo storage. Added automatically when you connect a Blob store in Vercel > Storage.
BLOB_READ_WRITE_TOKEN=

# Signs login sessions. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Lets Express parse request bodies itself on Vercel.
NODEJS_HELPERS=0
